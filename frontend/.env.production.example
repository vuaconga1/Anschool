# Copy to frontend/.env.production locally or set in Vercel → Environment Variables
# Do not commit real secrets.

# Root deploy on Vercel (anschool.vercel.app) — keep base as /
VITE_BASE_PATH=/

# Railway public API URL (no trailing slash before /api)
# Example: https://anschool-api.up.railway.app/api
VITE_API_BASE_URL=https://YOUR-RAILWAY-API.up.railway.app/api
